PORT=3000
NODE_ENV=development
JWT_SECRET=stocksprint_pro_secure_jwt_secret_key_2026

# Supabase Cloud Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Real Email Delivery Configuration (Nodemailer / SMTP / Gmail / SendGrid / Resend)
# For Gmail, use an App Password generated at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="StockSprint Pro" <noreply@stocksprint.in>

# Real SMS OTP Delivery Configuration (Twilio / Fast2SMS / MSG91)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Market Data Feed Settings
MARKET_DATA_PROVIDER=live_yahoo
MARKET_DATA_REFRESH_INTERVAL=60000

# Payment Gateway (e.g. Razorpay / Cashfree / PayU)
PAYMENT_GATEWAY_PROVIDER=mock
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
