PORT=3000
NODE_ENV=development
JWT_SECRET=stocksprint_pro_secure_jwt_secret_key_2026

# Supabase Cloud Database Configuration
# Get your Project URL and Anon/Service Key from https://app.supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Market Data Feed Settings
MARKET_DATA_PROVIDER=live_yahoo
MARKET_DATA_REFRESH_INTERVAL=60000

# Regulatory Indian KYC Provider (e.g. Digilocker / Karza / NSDL)
KYC_PROVIDER=mock
KYC_API_KEY=

# Payment Gateway (e.g. Razorpay / Cashfree / PayU)
PAYMENT_GATEWAY_PROVIDER=mock
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
